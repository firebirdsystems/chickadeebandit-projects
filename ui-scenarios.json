{
  "scenarios": [
    {
      "name": "a finished project's committed spend comes from the aggregate, not from the rows on screen",
      "members": {
        "owner": "adult"
      },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_projects__projects (id, name, status, visibility, budget_cap_cents, created_by, created_at, updated_at, completed_at) VALUES ('p-done', ?, 'done', 'everyone', 90000, ?, '2026-08-01T09:00:00Z', '2026-08-20T09:00:00Z', '2026-08-20T09:00:00Z')",
          "params": [
            "Bathroom renovation",
            "{{owner}}"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_projects__budget_items (id, project_id, label, estimated_cents, actual_cents, sort_order, created_by, created_at, updated_at) VALUES ('b-tile', 'p-done', ?, 40000, 45000, 0, ?, '2026-08-02T09:00:00Z', '2026-08-02T09:00:00Z')",
          "params": [
            "Matte floor tile",
            "{{owner}}"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_projects__budget_items (id, project_id, label, estimated_cents, sort_order, created_by, created_at, updated_at) VALUES ('b-fit', 'p-done', ?, 30000, 1, ?, '2026-08-03T09:00:00Z', '2026-08-03T09:00:00Z')",
          "params": [
            "Fitting the shower",
            "{{owner}}"
          ]
        },
        {
          "action": "open",
          "as": "owner"
        },
        {
          "action": "expectVisible",
          "as": "owner",
          "selector": "[data-testid=\"project-card\"][data-project-id=\"p-done\"]"
        },
        {
          "action": "expectText",
          "as": "owner",
          "selector": "[data-testid=\"project-card\"][data-project-id=\"p-done\"]",
          "text": "$750.00 of $900.00"
        },
        {
          "action": "click",
          "as": "owner",
          "selector": "[data-testid=\"project-card\"][data-project-id=\"p-done\"]"
        },
        {
          "action": "expectVisible",
          "as": "owner",
          "selector": "[data-testid=\"budget-row\"][data-item-id=\"b-tile\"]"
        },
        {
          "action": "expectVisible",
          "as": "owner",
          "selector": "[data-testid=\"budget-row\"][data-item-id=\"b-fit\"]"
        },
        {
          "action": "expectText",
          "as": "owner",
          "selector": "[data-testid=\"committed\"]",
          "text": "$750.00"
        },
        {
          "action": "expectText",
          "as": "owner",
          "selector": "[data-testid=\"tab-budget\"]",
          "text": "Budget (2)"
        }
      ]
    },
    {
      "name": "a child may correct their own budget line and not an adult's, while an adult may correct either",
      "members": {
        "grown": "adult",
        "kid": "child"
      },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_projects__projects (id, name, status, visibility, created_by, created_at, updated_at) VALUES ('p-open', ?, 'active', 'everyone', ?, '2026-08-01T09:00:00Z', '2026-08-01T09:00:00Z')",
          "params": [
            "Treehouse build",
            "{{grown}}"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_projects__budget_items (id, project_id, label, estimated_cents, sort_order, created_by, created_at, updated_at) VALUES ('b-grown', 'p-open', ?, 12000, 0, ?, '2026-08-02T09:00:00Z', '2026-08-02T09:00:00Z')",
          "params": [
            "Pressure-treated posts",
            "{{grown}}"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_projects__budget_items (id, project_id, label, estimated_cents, sort_order, created_by, created_at, updated_at) VALUES ('b-kid', 'p-open', ?, 3000, 1, ?, '2026-08-02T10:00:00Z', '2026-08-02T10:00:00Z')",
          "params": [
            "Rope ladder",
            "{{kid}}"
          ]
        },
        {
          "action": "open",
          "as": "kid"
        },
        {
          "action": "expectVisible",
          "as": "kid",
          "selector": "[data-testid=\"project-card\"][data-project-id=\"p-open\"]"
        },
        {
          "action": "click",
          "as": "kid",
          "selector": "[data-testid=\"project-card\"][data-project-id=\"p-open\"]"
        },
        {
          "action": "expectVisible",
          "as": "kid",
          "selector": "[data-testid=\"budget-row\"][data-item-id=\"b-grown\"]"
        },
        {
          "action": "expectVisible",
          "as": "kid",
          "selector": "[data-testid=\"budget-edit\"][data-item-id=\"b-kid\"]"
        },
        {
          "action": "expectCount",
          "as": "kid",
          "selector": "[data-testid=\"budget-edit\"][data-item-id=\"b-grown\"]",
          "count": 0
        },
        {
          "action": "open",
          "as": "grown"
        },
        {
          "action": "expectVisible",
          "as": "grown",
          "selector": "[data-testid=\"project-card\"][data-project-id=\"p-open\"]"
        },
        {
          "action": "click",
          "as": "grown",
          "selector": "[data-testid=\"project-card\"][data-project-id=\"p-open\"]"
        },
        {
          "action": "expectVisible",
          "as": "grown",
          "selector": "[data-testid=\"budget-row\"][data-item-id=\"b-kid\"]"
        },
        {
          "action": "expectVisible",
          "as": "grown",
          "selector": "[data-testid=\"budget-edit\"][data-item-id=\"b-grown\"]"
        },
        {
          "action": "expectVisible",
          "as": "grown",
          "selector": "[data-testid=\"budget-edit\"][data-item-id=\"b-kid\"]"
        },
        {
          "action": "expectVisible",
          "as": "grown",
          "selector": "[data-testid=\"budget-delete\"][data-item-id=\"b-kid\"]"
        }
      ]
    },
    {
